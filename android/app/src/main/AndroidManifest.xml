<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 새 문자 감지 (받은 문자함 전체를 읽는 READ_SMS 는 쓰지 않는다) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- 저장된 번호는 검사에서 제외 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 위험 문자 경고 알림 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 음성 비서: 확인 후 바로 전화 걸기, 알람 맞추기 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- 전화·문자 기능이 없는 기기(태블릿)에도 설치할 수 있게 -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 음성 비서: "카카오톡 열어 줘" 할 때 설치된 앱 목록에서 찾는다 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="스마트 헬퍼"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".guard.WarningActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <!-- BROADCAST_SMS: 시스템만 이 수신기를 부를 수 있다 (다른 앱의 가짜 문자 방지) -->
        <receiver
            android:name=".guard.SmishingReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
